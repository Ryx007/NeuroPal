{
  "expo": {
    "name": "NeuroPal",
    "slug": "neuropal",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "neuropal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#131313",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.neuropal.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NeuroPal uses your microphone only if you opt in to voice capture for notes. Never transmitted without consent.",
        "NSSpeechRecognitionUsageDescription": "NeuroPal uses on-device speech recognition for dictation into notes and Q&A.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "io.neuropal.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131313"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ],
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#131313",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "NeuroPal adds your anchors and reminders to your calendar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NeuroPal uses your location to trigger place-based anchors while the app is open."
        }
      ],
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/space-grotesk/700Bold/SpaceGrotesk_700Bold.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "./assets/fonts/Archivo-Bold.ttf",
            "./assets/fonts/AtkinsonHyperlegibleNext-600.ttf",
            "./assets/fonts/AtkinsonHyperlegibleMono-700.ttf"
          ],
          "widgets": [
            {
              "name": "Pal",
              "label": "Pal",
              "description": "Check in with Pal and see your next anchor.",
              "minWidth": "140dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget/pal-preview.png"
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
