<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the widget extension: today's state, anchors and Pal
	     (Packages/NeuroPalCore SharedStore). Register the group in the
	     Apple Developer account before the first device build. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.neuropal.ios</string>
	</array>
</dict>
</plist>
