# NeuroPal VPS — environment keys. bootstrap.sh writes the real ./.env next
# to docker-compose.yml with fresh random secrets (chmod 600); this file only
# documents the keys. NEVER commit the real .env — the repo is public.

# ---- databases (internal Docker network only; no host ports) -------------
MONGO_ROOT_USER=neuropal
# hex only — it is embedded in a mongodb:// URI
MONGO_ROOT_PASSWORD=
# the API's own user: readWrite on `neuropal` only (mongo-init/)
MONGO_APP_USER=neuropal_app
MONGO_APP_PASSWORD=
QDRANT_API_KEY=

# ---- sign-in ---------------------------------------------------------------
# 64 hex chars
JWT_SECRET=
# invite (default) | closed | open. With invite, registering needs the code.
SIGNUP_MODE=invite
# np- + 32 hex chars (128 bits)
SIGNUP_INVITE_CODE=

# ---- AI ---------------------------------------------------------------------
# gemini | anthropic | ollama  (docs/HANDOFF.md §0: the free Gemini tier may
# use what you send to improve Google's products; the paid tier doesn't)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Checked against the live model list at deploy time.
GEMINI_MODEL=gemini-flash-latest
# AI answers per account per day (0 = no limit)
AI_DAILY_LIMIT_PER_USER=150
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- web clients -------------------------------------------------------------
# Browser origins allowed to call the API (native apps need nothing here).
CORS_ORIGINS=https://ryx007.work,https://www.ryx007.work

# Optional: a release APK inside the storage volume, served at /apk
APK_PATH=

